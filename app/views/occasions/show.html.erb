<% page_title "#{@occasion.name} corporate gifts" %>
<% meta_description "#{@occasion.name} gifts for employees — curated, branded and delivered across India. Get a custom quote. #{@occasion.tagline}" %>
<% themes = { "saffron" => "from-saffron-400 via-saffron-500 to-rani-500", "rani" => "from-rani-400 via-rani-500 to-plum-600", "plum" => "from-plum-500 via-plum-700 to-plum-900", "emerald" => "from-emerald-400 via-teal-500 to-sky-600", "sky" => "from-sky-400 via-indigo-500 to-plum-600" } %>
<section class="relative overflow-hidden bg-gradient-to-br <%= themes[@occasion.theme] %> pt-32 pb-20 text-white sm:pt-40">
  <div class="absolute inset-0 opacity-20 [background-image:radial-gradient(white_1px,transparent_1px)] [background-size:22px_22px]"></div>
  <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-6 lg:grid-cols-2">
    <div class="animate-fade-up">
      <%= link_to root_path(anchor: "occasions"), class: "inline-flex items-center gap-1 text-sm font-semibold text-white/80 hover:text-white" do %><%= icon("chevron-left", class: "h-4 w-4") %> All occasions<% end %>
      <h1 class="mt-4 font-display text-5xl font-semibold sm:text-6xl"><%= @occasion.name %> gifting</h1>
      <p class="mt-4 text-xl text-white/90"><%= @occasion.tagline %></p>
      <p class="mt-6 inline-flex items-center gap-3 rounded-2xl bg-white/15 px-5 py-3 backdrop-blur">
        <%= icon("sparkles", class: "h-6 w-6 text-marigold-300") %>
        <span><span class="block font-semibold">Pricing tailored to your team</span><span class="block text-sm text-white/80">Share headcount &amp; budget — quote within one business day</span></span>
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <%= link_to "Get a quote for #{@occasion.name}", new_contact_path(occasion: @occasion.slug), class: "btn btn-lg bg-white text-plum-900 shadow-xl hover:-translate-y-0.5", data: { track: "Get a quote: #{@occasion.name}" } %>
      </div>
    </div>
    <div class="relative mx-auto grid h-80 w-80 place-items-center sm:h-96 sm:w-96" aria-hidden="true">
      <div class="absolute inset-0 rounded-full bg-white/15 blur-2xl"></div>
      <div class="absolute inset-8 rounded-full ring-1 ring-white/30"></div>
      <div class="absolute inset-16 rounded-full ring-1 ring-white/20"></div>
      <span class="relative text-[9rem] drop-shadow-2xl animate-float"><%= @occasion.emoji %></span>
    </div>
  </div>
</section>

<section class="py-20" data-controller="reveal">
  <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-3">
    <div class="lg:col-span-2" data-reveal-target="item">
      <h2 class="font-display text-3xl font-semibold text-plum-950">About this collection</h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-600"><%= @occasion.description %></p>
      <h3 class="mt-10 text-sm font-semibold uppercase tracking-widest text-saffron-600">What's typically inside</h3>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        <% Array(@occasion.highlights).each do |h| %>
          <li class="flex items-start gap-3 rounded-2xl bg-white p-4 ring-1 ring-slate-200/70"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-emerald-50 text-emerald-600"><%= icon("check", class: "h-4 w-4", stroke: 2.4) %></span><span class="text-sm font-medium text-slate-700"><%= h %></span></li>
        <% end %>
      </ul>
      <div class="mt-10 rounded-3xl bg-plum-50 p-6 ring-1 ring-plum-100">
        <p class="font-semibold text-plum-900">Packages & full pricing</p>
        <p class="mt-1 text-sm text-plum-700">Detailed package contents and live per-kit pricing are available to registered companies in the HR portal. Request a demo and we'll set you up.</p>
      </div>
    </div>
    <aside class="reveal" data-reveal-target="item">
      <div class="card card-body sticky top-28">
        <p class="font-display text-xl font-semibold text-plum-900">Every <%= @occasion.name %> order includes</p>
        <ul class="mt-4 space-y-3 text-sm text-slate-600">
          <% ["Logo branding & personalised cards", "Doorstep or office delivery", "Per-recipient tracking", "GST invoice & delivery report", "Dedicated account manager"].each do |t| %>
            <li class="flex items-center gap-2"><%= icon("check-circle", class: "h-5 w-5 text-saffron-500") %><%= t %></li>
          <% end %>
        </ul>
        <%= link_to "Request a quote", new_contact_path(occasion: @occasion.slug), class: "btn btn-primary mt-6 w-full" %>
      </div>
    </aside>
  </div>
</section>

<% if @others.any? %>
  <section class="bg-white py-20" data-controller="reveal">
    <div class="mx-auto max-w-7xl px-6">
      <h2 class="font-display text-3xl font-semibold text-plum-950">Explore other occasions</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <% @others.each_with_index { |o, i| %><%= render "public/occasion_card", occasion: o, delay: i * 80 %><% } %>
      </div>
    </div>
  </section>
<% end %>
