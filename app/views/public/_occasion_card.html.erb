<%# locals: (occasion:, delay: 0) %>
<% tints = {
  "saffron" => "from-saffron-50 to-marigold-100 text-saffron-700",
  "rani" => "from-rani-50 to-rani-100 text-rani-700",
  "plum" => "from-plum-50 to-plum-100 text-plum-700",
  "emerald" => "from-emerald-50 to-teal-100 text-emerald-700",
  "sky" => "from-sky-50 to-indigo-100 text-indigo-700"
} %>
<%= link_to occasion_path(occasion), class: "group flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-900/10 hover:ring-slate-300", style: "transition-delay: #{delay}ms", data: { reveal_target: "item", track: "Occasion card: #{occasion.name}" } do %>
  <div class="relative grid h-36 place-items-center bg-gradient-to-br <%= tints[occasion.theme] || tints["saffron"] %>">
    <div class="absolute inset-0 opacity-40 [background-image:radial-gradient(currentColor_1px,transparent_1px)] [background-size:16px_16px] [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
    <span class="relative text-6xl transition duration-500 group-hover:scale-110"><%= occasion.emoji %></span>
    <% if occasion.in_season? %><span class="absolute right-3 top-3 rounded-full bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-700 shadow-sm ring-1 ring-slate-200">In season</span><% end %>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-bold tracking-tight text-slate-900"><%= occasion.name %></h3>
    <p class="mt-1 flex-1 text-sm leading-relaxed text-slate-600"><%= occasion.tagline %></p>
    <p class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-900 group-hover:text-saffron-600">Get a quote <%= icon("arrow-right", class: "h-4 w-4 transition group-hover:translate-x-1", stroke: 2) %></p>
  </div>
<% end %>
