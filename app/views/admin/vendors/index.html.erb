<% page_title "Vendors" %>
<%= render Ui::PageHeaderComponent.new(title: "Vendors", subtitle: "Approval queue, KYC, coverage and performance of your supplier network.", eyebrow: "Supply") %>
<%= render "admin/shared/tabs", tabs: { "pending" => "Approval queue", "approved" => "Approved", "rejected" => "Rejected", "suspended" => "Suspended" }, counts: @counts, path_helper: :admin_vendors_path %>
<%= form_with url: admin_vendors_path, method: :get, class: "mb-5 max-w-md" do |f| %>
  <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
  <div class="relative"><span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><%= icon("search", class: "h-4 w-4") %></span><%= f.search_field :q, value: params[:q], placeholder: "Search by name or GSTIN…", class: "input pl-9", aria: { label: "Search vendors" } %></div>
<% end %>
<% if @vendors.any? %>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @vendors.each do |v| %>
      <%= link_to admin_vendor_path(v), class: "card card-body group transition hover:-translate-y-0.5 hover:shadow-lg" do %>
        <div class="flex items-start gap-3">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-400 text-sm font-bold text-white shadow"><%= v.name.first(2).upcase %></span>
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-2"><p class="truncate font-semibold text-slate-900 group-hover:text-saffron-700"><%= v.name %></p><%= vendor_status_badge(v) %></div>
            <p class="text-xs text-slate-500"><%= [v.warehouse_city, v.warehouse_state].compact.join(", ").presence || "Location pending" %> · <%= v.gstin || "No GSTIN yet" %></p>
          </div>
        </div>
        <div class="mt-4 grid grid-cols-3 gap-2 text-center">
          <div class="rounded-xl bg-slate-50 py-2"><p class="text-lg font-bold text-slate-900"><%= @offer_counts[v.id].to_i %></p><p class="text-[11px] text-slate-500">Offers</p></div>
          <div class="rounded-xl bg-slate-50 py-2"><p class="text-lg font-bold text-slate-900"><%= @region_counts[v.id].to_i %></p><p class="text-[11px] text-slate-500">Regions</p></div>
          <div class="rounded-xl bg-slate-50 py-2"><p class="flex items-center justify-center gap-1 text-lg font-bold text-slate-900"><%= icon("star", class: "h-4 w-4 text-marigold-500") %><%= v.rating.to_f %></p><p class="text-[11px] text-slate-500">Rating</p></div>
        </div>
        <% if v.pending? %>
          <p class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800"><%= v.kyc_complete? ? "KYC complete — ready for review" : "Missing: #{v.kyc_missing.to_sentence}" %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <%= pagy_nav_tw(@pagy) %>
<% else %>
  <%= render Ui::EmptyStateComponent.new(title: "No vendors here", body: "New applications from /become-a-vendor appear in the approval queue.", icon: "briefcase") %>
<% end %>
