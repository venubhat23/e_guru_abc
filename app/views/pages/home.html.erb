<% page_title "Corporate gifting, managed end-to-end" %>

<%# =============================== HERO =============================== %>
<section class="relative isolate overflow-hidden bg-white pt-32 pb-20 sm:pt-40 lg:pb-28">
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#f1f5f9_1px,transparent_1px),linear-gradient(to_bottom,#f1f5f9_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"></div>
  <div class="absolute left-1/2 top-0 -z-10 h-[32rem] w-[64rem] -translate-x-1/2 rounded-full bg-gradient-to-b from-saffron-100/70 via-rani-50/40 to-transparent blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-4xl text-center animate-fade-up">
      <%= link_to occasion_path(@occasions.find(&:in_season?) || @occasions.first || "diwali"), class: "inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white py-1 pl-1 pr-3 text-sm font-medium text-slate-700 shadow-sm transition hover:border-slate-300", data: { track: "Hero: seasonal badge" } do %>
        <span class="rounded-full bg-plum-950 px-2.5 py-0.5 text-xs font-semibold text-white">New</span>
        Diwali 2026 hampers are now booking
        <%= icon("chevron-right", class: "h-4 w-4 text-slate-400", stroke: 2) %>
      <% end %>
      <h1 class="mt-8 font-display text-5xl font-extrabold leading-[1.05] tracking-tight text-slate-950 sm:text-6xl lg:text-7xl">
        Corporate gifting,<br class="hidden sm:block"> <span class="bg-gradient-to-r from-saffron-600 to-rani-600 bg-clip-text text-transparent">handled end-to-end.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        One platform to curate, brand and deliver gifts to every employee across India — with verified vendors, live tracking and a single GST-compliant invoice.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <%= link_to new_contact_path, class: "btn btn-lg bg-plum-950 text-white shadow-lg shadow-plum-950/20 hover:-translate-y-0.5 hover:bg-plum-900", data: { track: "Hero: Get a custom quote" } do %>Get a custom quote <%= icon("arrow-right", class: "h-4 w-4", stroke: 2.2) %><% end %>
        <%= link_to root_path(anchor: "build"), class: "btn btn-lg btn-secondary", data: { track: "Hero: Build your box" } do %><%= icon("cube", class: "h-5 w-5") %> Build your gift box<% end %>
      </div>
      <p class="mt-5 text-sm text-slate-500">No minimum order · Free branding mock-ups · Quote within one business day</p>
    </div>

    <%# Product mock-up %>
    <div class="relative mx-auto mt-16 max-w-6xl animate-fade-up sm:mt-20" style="animation-delay:.15s" aria-hidden="true" data-controller="tilt" data-tilt-max-value="4" data-action="mousemove->tilt#move mouseleave->tilt#leave">
      <div class="absolute -inset-x-10 -bottom-10 top-10 -z-10 rounded-[3rem] bg-gradient-to-r from-saffron-200/40 via-rani-200/40 to-plum-200/40 blur-3xl"></div>
      <div class="tilt rounded-2xl bg-slate-900/5 p-2 ring-1 ring-slate-900/10 backdrop-blur sm:rounded-3xl sm:p-3" data-tilt-target="card">
        <div class="overflow-hidden rounded-xl bg-white shadow-2xl shadow-slate-900/10 ring-1 ring-slate-200 sm:rounded-2xl">
          <div class="flex items-center gap-2 border-b border-slate-100 bg-slate-50/80 px-4 py-3">
            <span class="h-3 w-3 rounded-full bg-slate-300"></span><span class="h-3 w-3 rounded-full bg-slate-300"></span><span class="h-3 w-3 rounded-full bg-slate-300"></span>
            <span class="mx-auto hidden rounded-md bg-white px-24 py-1 text-xs text-slate-400 ring-1 ring-slate-200 sm:block">app.egiftmitra.in/hr</span>
          </div>
          <div class="grid lg:grid-cols-[13rem_1fr]">
            <aside class="hidden border-r border-slate-100 p-4 lg:block">
              <p class="flex items-center gap-2 text-sm font-bold text-slate-900"><span class="grid h-7 w-7 place-items-center rounded-lg bg-gradient-to-br from-saffron-500 to-rani-500 text-white"><%= icon("gift", class: "h-4 w-4", stroke: 2) %></span>eGiftMitra</p>
              <ul class="mt-6 space-y-1 text-sm">
                <% [["home", "Overview", true], ["gift", "Campaigns", false], ["users", "Recipients", false], ["truck", "Deliveries", false], ["receipt", "Invoices", false], ["chart", "Reports", false]].each do |ic, label, active| %>
                  <li class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 <%= active ? "bg-slate-100 font-semibold text-slate-900" : "text-slate-500" %>"><%= icon(ic, class: "h-4 w-4") %><%= label %></li>
                <% end %>
              </ul>
            </aside>
            <div class="p-4 text-left sm:p-6">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div><p class="text-xs font-medium text-slate-500">Campaign</p><p class="text-lg font-bold text-slate-900">Diwali 2026 · All offices</p></div>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>In delivery</span>
              </div>
              <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
                <% [["Recipients", "1,840", "18 cities"], ["Delivered", "1,712", "93%"], ["In transit", "128", "ETA 2 days"], ["Satisfaction", "4.8/5", "312 responses"]].each do |label, val, sub| %>
                  <div class="rounded-xl border border-slate-200 p-3.5">
                    <p class="text-xs font-medium text-slate-500"><%= label %></p>
                    <p class="mt-1 text-xl font-bold tracking-tight text-slate-900 sm:text-2xl"><%= val %></p>
                    <p class="text-xs text-slate-400"><%= sub %></p>
                  </div>
                <% end %>
              </div>
              <div class="mt-5 overflow-hidden rounded-xl border border-slate-200">
                <table class="w-full text-sm">
                  <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                    <tr><th class="px-4 py-2.5">Employee</th><th class="hidden px-4 py-2.5 sm:table-cell">Location</th><th class="hidden px-4 py-2.5 md:table-cell">Kit</th><th class="px-4 py-2.5 text-right">Status</th></tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <% [["AK", "Ananya Krishnan", "Bengaluru", "Signature hamper", "Delivered", "bg-emerald-50 text-emerald-700 ring-emerald-200"],
                        ["RS", "Rohit Sharma", "Pune", "Signature hamper", "Out for delivery", "bg-amber-50 text-amber-700 ring-amber-200"],
                        ["PM", "Priya Menon", "Gurugram", "Wellness kit", "Delivered", "bg-emerald-50 text-emerald-700 ring-emerald-200"],
                        ["NJ", "Nikhil Joshi", "Hyderabad", "Signature hamper", "Packed", "bg-sky-50 text-sky-700 ring-sky-200"]].each do |ini, name, city, kit, status, badge| %>
                      <tr>
                        <td class="px-4 py-3"><span class="flex items-center gap-3"><span class="grid h-8 w-8 place-items-center rounded-full bg-slate-100 text-[11px] font-bold text-slate-600"><%= ini %></span><span class="font-medium text-slate-800"><%= name %></span></span></td>
                        <td class="hidden px-4 py-3 text-slate-500 sm:table-cell"><%= city %></td>
                        <td class="hidden px-4 py-3 text-slate-500 md:table-cell"><%= kit %></td>
                        <td class="px-4 py-3 text-right"><span class="rounded-full px-2.5 py-1 text-xs font-semibold ring-1 <%= badge %>"><%= status %></span></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="absolute -left-4 top-[62%] hidden w-60 rounded-2xl bg-white p-4 text-left shadow-2xl shadow-slate-900/15 ring-1 ring-slate-200 animate-float-slow md:block lg:-left-24">
        <p class="flex items-center gap-2 text-sm font-semibold text-slate-900"><span class="grid h-8 w-8 place-items-center rounded-lg bg-emerald-50 text-emerald-600"><%= icon("check-circle", class: "h-5 w-5") %></span>Quote approved</p>
        <p class="mt-2 text-xs leading-relaxed text-slate-500">Finance approved 1,840 kits. Vendors notified automatically.</p>
      </div>
      <div class="absolute -right-4 bottom-10 hidden w-56 rounded-2xl bg-plum-950 p-4 text-left text-white shadow-2xl animate-float md:block lg:-right-10" style="animation-delay:-3s">
        <p class="flex items-center gap-2 text-sm font-semibold"><span class="grid h-8 w-8 place-items-center rounded-lg bg-white/10 text-marigold-300"><%= icon("document", class: "h-5 w-5") %></span>Tax invoice ready</p>
        <p class="mt-2 text-xs text-plum-200">One consolidated GST invoice · PDF</p>
      </div>
    </div>
  </div>
</section>

<%# =============================== TRUST BAND =============================== %>
<section class="border-y border-slate-100 bg-slate-50/60 py-10" aria-label="Industries we serve">
  <div class="mx-auto max-w-7xl px-6">
    <p class="text-center text-sm font-medium text-slate-500">Built for People, HR and Admin teams across India's fastest-growing industries</p>
    <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-12 gap-y-4">
      <% [["globe", "IT & SaaS"], ["banknotes", "BFSI"], ["shield", "Pharma & Healthcare"], ["cube", "Manufacturing"], ["bolt", "Startups"], ["building", "Consulting"]].each do |ic, name| %>
        <li class="flex items-center gap-2 text-lg font-bold tracking-tight text-slate-400"><%= icon(ic, class: "h-6 w-6") %><%= name %></li>
      <% end %>
    </ul>
  </div>
</section>

<%# =============================== STATS =============================== %>
<section class="bg-white py-20" data-controller="counter">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-y-10 px-6 lg:grid-cols-4 lg:divide-x lg:divide-slate-100">
    <% [["19000", "+", "Pincodes served", "From metros to tier-3 towns"], ["48", "h", "Vendor confirmation SLA", "Every order acknowledged fast"], ["24", "h", "Quote turnaround", "Curated proposal, one business day"], ["100", "%", "GST-compliant billing", "CGST/SGST or IGST, done right"]].each do |n, suffix, label, sub| %>
      <div class="px-4 text-center lg:px-8">
        <p class="text-4xl font-extrabold tracking-tight text-slate-950 sm:text-5xl"><span data-counter-target="number" data-value="<%= n %>"><%= Inr.group(n.to_i) %></span><span class="text-saffron-600"><%= suffix %></span></p>
        <p class="mt-2 font-semibold text-slate-800"><%= label %></p>
        <p class="mt-1 text-sm text-slate-500"><%= sub %></p>
      </div>
    <% end %>
  </div>
</section>

<%# =============================== OCCASIONS =============================== %>
<section id="occasions" class="scroll-mt-24 bg-slate-50 py-24" data-controller="reveal">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end" data-reveal-target="item">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-saffron-600">Solutions</p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">A gifting programme for every moment</h2>
        <p class="mt-4 text-lg text-slate-600">Ready-to-ship collections designed by our gifting experts — fully brandable, quoted to your budget and delivered anywhere in India.</p>
      </div>
      <%= link_to new_contact_path, class: "inline-flex shrink-0 items-center gap-1.5 font-semibold text-slate-900 hover:text-saffron-600", data: { track: "Occasions: Talk to an expert" } do %>Talk to a gifting expert <%= icon("arrow-right", class: "h-4 w-4", stroke: 2) %><% end %>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      <% @occasions.each_with_index do |occasion, i| %>
        <%= render "public/occasion_card", occasion:, delay: i * 60 %>
      <% end %>
    </div>
  </div>
</section>

<%# =============================== QUOTE BUILDER =============================== %>
<section id="build" class="scroll-mt-24 bg-white py-24" data-controller="reveal">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal-target="item">
      <p class="text-sm font-semibold text-saffron-600">Build your box</p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">Configure your gift in 30 seconds</h2>
      <p class="mt-4 text-lg text-slate-600">Tell us what you have in mind. Our team turns it into a curated, branded proposal with a custom quote — usually within one business day.</p>
    </div>

    <div class="mt-14 overflow-hidden rounded-3xl bg-white shadow-xl shadow-slate-900/5 ring-1 ring-slate-200" data-reveal-target="item"
         data-controller="quote-builder" data-quote-builder-url-value="<%= new_contact_path %>">
      <div class="grid lg:grid-cols-5">
        <div class="space-y-9 p-6 sm:p-10 lg:col-span-3">
          <div>
            <p class="flex items-center gap-3 font-semibold text-slate-900"><span class="qb-step" data-quote-builder-target="step">1</span> What's the occasion?</p>
            <div class="mt-4 flex flex-wrap gap-2.5">
              <% @occasions.each do |o| %>
                <button type="button" class="chip" aria-pressed="false" data-quote-builder-target="occasion" data-name="<%= o.name %>" data-slug="<%= o.slug %>" data-action="quote-builder#pickOccasion" data-track="Quote builder: occasion <%= o.name %>"><span><%= o.emoji %></span><%= o.name %></button>
              <% end %>
            </div>
          </div>
          <div>
            <p class="flex items-center gap-3 font-semibold text-slate-900"><span class="qb-step is-done" data-quote-builder-target="step">2</span> How many people are you gifting?</p>
            <div class="mt-5 flex items-center gap-5">
              <div class="relative flex-1">
                <div class="pointer-events-none absolute inset-x-0 inset-y-0 my-auto h-2 rounded-full bg-slate-100"></div>
                <div class="pointer-events-none absolute inset-y-0 left-0 my-auto h-2 rounded-full bg-plum-950" data-quote-builder-target="fill"></div>
                <input type="range" min="10" max="5000" step="10" value="250" class="range-gift relative bg-transparent" aria-label="Number of recipients" data-quote-builder-target="headcount" data-action="input->quote-builder#update">
              </div>
              <p class="w-24 text-right text-3xl font-extrabold tracking-tight text-slate-950 tabular-nums" data-quote-builder-target="headcountLabel">250</p>
            </div>
            <div class="mt-2 flex justify-between text-xs font-medium text-slate-400"><span>10</span><span>1,000</span><span>5,000+</span></div>
          </div>
          <div>
            <p class="flex items-center gap-3 font-semibold text-slate-900"><span class="qb-step" data-quote-builder-target="step">3</span> What goes inside? <span class="text-sm font-normal text-slate-500">Choose any</span></p>
            <div class="mt-4 flex flex-wrap gap-2.5">
              <% [["🍫", "Chocolates"], ["🥜", "Dry fruits"], ["🍬", "Organic sweets"], ["☕", "Mugs"], ["🧴", "Bottles"], ["📔", "Diaries"], ["👕", "T-shirts"], ["🎧", "Tech gadgets"], ["👜", "Bags"], ["🪔", "Diyas & decor"], ["🖼️", "Art"], ["💌", "Personal cards"]].each do |emoji, name| %>
                <button type="button" class="chip" aria-pressed="false" data-quote-builder-target="style" data-name="<%= name %>" data-emoji="<%= emoji %>" data-action="quote-builder#toggleStyle" data-track="Quote builder: item <%= name %>"><span><%= emoji %></span><%= name %></button>
              <% end %>
            </div>
          </div>
          <div>
            <p class="flex items-center gap-3 font-semibold text-slate-900"><span class="qb-step" data-quote-builder-target="step">4</span> How should it be delivered?</p>
            <div class="mt-4 grid gap-2.5 sm:grid-cols-3">
              <% [["home", "Home delivery", "To each employee"], ["building", "Bulk to office", "One or many sites"], ["link", "Self-fill link", "Employees add address"]].each do |ic, name, sub| %>
                <button type="button" class="chip flex-col items-start gap-1 py-3.5 text-left" aria-pressed="false" data-quote-builder-target="delivery" data-name="<%= name %>" data-action="quote-builder#pickDelivery" data-track="Quote builder: delivery <%= name %>">
                  <span class="flex items-center gap-2"><%= icon(ic, class: "h-4 w-4") %><%= name %></span><span class="text-xs font-medium opacity-75"><%= sub %></span>
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <div class="relative flex flex-col bg-plum-950 p-6 text-white sm:p-10 lg:col-span-2">
          <div class="absolute inset-0 pattern-grid-dark"></div>
          <div class="relative">
            <p class="text-xs font-semibold uppercase tracking-widest text-plum-300">Your request</p>
            <p class="mt-2 text-2xl font-bold tracking-tight" data-quote-builder-target="summary">Any occasion · 250 people</p>
            <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-white/10"><div class="h-full rounded-full bg-saffron-500 transition-all duration-500" style="width:25%" data-quote-builder-target="progress"></div></div>
          </div>
          <div class="relative mt-8 flex-1 rounded-2xl border border-dashed border-white/20 bg-white/[.03] p-5">
            <div class="flex min-h-[9rem] flex-wrap content-start gap-3" data-quote-builder-target="box"></div>
            <p class="absolute inset-0 grid place-items-center px-6 text-center text-sm text-plum-300" data-quote-builder-target="emptyHint"><span><%= icon("cube", class: "mx-auto mb-2 h-8 w-8 text-plum-400") %>Select items to build your box</span></p>
          </div>
          <ul class="relative mt-6 space-y-2.5 text-sm text-plum-100">
            <% ["Free logo & branding mock-up", "Personalised card for each employee", "Dedicated gifting manager"].each do |t| %>
              <li class="flex items-center gap-2"><%= icon("check", class: "h-4 w-4 text-emerald-400", stroke: 2.5) %><%= t %></li>
            <% end %>
          </ul>
          <%= link_to new_contact_path, class: "btn btn-lg group relative mt-7 w-full bg-white text-slate-950 hover:bg-slate-100", data: { quote_builder_target: "cta", track: "Quote builder: Get my custom quote" } do %>
            Get my custom quote <%= icon("arrow-right", class: "h-5 w-5 transition group-hover:translate-x-1", stroke: 2.2) %>
          <% end %>
          <p class="relative mt-3 text-center text-xs text-plum-300">No commitment · Reply within one business day</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%# =============================== HOW IT WORKS =============================== %>
<section class="border-t border-slate-100 bg-slate-50 py-24" data-controller="reveal">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal-target="item">
      <p class="text-sm font-semibold text-saffron-600">How it works</p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">From brief to doorstep in four steps</h2>
    </div>
    <ol class="relative mt-16 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <li class="absolute left-[12.5%] right-[12.5%] top-6 hidden h-px list-none bg-slate-200 lg:block" aria-hidden="true"></li>
      <% [
        ["sparkles", "Choose", "Pick a curated collection for the occasion, or build your own box item by item."],
        ["users", "Add recipients", "Upload your employee list, or let employees add their own address and size via a secure link."],
        ["receipt", "Approve your quote", "Receive a tailored quote and proforma with the GST split. Pay online or by bank transfer."],
        ["truck", "We deliver", "Verified vendors pack, brand and ship. Track every recipient and download delivery reports."]
      ].each_with_index do |(ic, title, body), i| %>
        <li class="relative text-center lg:px-2" style="transition-delay: <%= i * 100 %>ms" data-reveal-target="item">
          <span class="relative mx-auto grid h-12 w-12 place-items-center rounded-full bg-white text-plum-950 shadow-sm ring-1 ring-slate-200"><%= icon(ic, class: "h-5 w-5", stroke: 1.8) %></span>
          <p class="mt-5 text-xs font-bold uppercase tracking-widest text-saffron-600">Step <%= i + 1 %></p>
          <h3 class="mt-1 text-lg font-bold text-slate-900"><%= title %></h3>
          <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-slate-600"><%= body %></p>
        </li>
      <% end %>
    </ol>
    <div class="mt-14 text-center"><%= link_to how_it_works_path, class: "btn btn-secondary", data: { track: "How it works: See the full process" } do %>See the full process <%= icon("arrow-right", class: "h-4 w-4") %><% end %></div>
  </div>
</section>

<%# =============================== WHY US =============================== %>
<section id="why-us" class="scroll-mt-24 bg-white py-24" data-controller="reveal">
  <div class="mx-auto max-w-7xl px-6">
    <div class="max-w-2xl" data-reveal-target="item">
      <p class="text-sm font-semibold text-saffron-600">Why Avighna eGiftMitra</p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">Gifting that HR doesn't have to chase</h2>
      <p class="mt-4 text-lg text-slate-600">One partner replaces a dozen vendor calls, spreadsheet trackers and courier follow-ups. You get a single invoice and real-time visibility.</p>
    </div>
    <div class="mt-14 grid gap-px overflow-hidden rounded-3xl bg-slate-200 ring-1 ring-slate-200 sm:grid-cols-2 lg:grid-cols-3">
      <% [
        ["shield", "Verified vendors only", "Every supplier is KYC-checked — GSTIN, PAN, FSSAI for food — and scored on quality and on-time delivery."],
        ["map-pin", "Pan-India doorstep delivery", "Home delivery, bulk to offices, or employee self-fill. Track each recipient with AWB links."],
        ["palette", "Your brand, everywhere", "Logo on products, personalised cards with each employee's name, custom messages from leadership."],
        ["receipt", "GST-perfect paperwork", "Proforma, tax invoice with CGST/SGST or IGST by place of supply, credit notes and delivery reports."],
        ["bolt", "Automated occasions", "Birthdays, work anniversaries and onboarding kits go out automatically — nobody gets forgotten."],
        ["chart", "Spend insights", "See spend by occasion, department and month, with approvals that keep budgets in control."]
      ].each_with_index do |(ic, title, body), i| %>
        <div class="group bg-white p-8 transition hover:bg-slate-50" data-reveal-target="item">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-saffron-50 text-saffron-600 ring-1 ring-saffron-100 transition group-hover:bg-plum-950 group-hover:text-white group-hover:ring-plum-950"><%= icon(ic, class: "h-5 w-5") %></span>
          <h3 class="mt-5 text-lg font-bold text-slate-900"><%= title %></h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= body %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# =============================== ENTERPRISE =============================== %>
<section id="enterprise" class="relative scroll-mt-24 overflow-hidden bg-plum-950 py-24 text-white" data-controller="reveal">
  <div class="absolute inset-0 pattern-grid-dark"></div>
  <div class="absolute -right-40 -top-40 h-[30rem] w-[30rem] rounded-full bg-rani-600/20 blur-3xl"></div>
  <div class="absolute -bottom-40 -left-40 h-[30rem] w-[30rem] rounded-full bg-saffron-600/15 blur-3xl"></div>
  <div class="relative mx-auto grid max-w-7xl items-center gap-16 px-6 lg:grid-cols-2">
    <div data-reveal-target="item">
      <p class="text-sm font-semibold text-saffron-400">Enterprise-ready</p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">The control finance wants. The ease HR deserves.</h2>
      <p class="mt-5 text-lg text-plum-200">Every order, recipient and rupee is visible in one HR portal — so gifting at scale stays auditable, on budget and on time.</p>
      <dl class="mt-10 grid gap-8 sm:grid-cols-2">
        <% [
          ["users", "Role-based portals", "Separate, secure access for HR, finance approvers and our vendor network."],
          ["clipboard", "Full audit trail", "Every change to an order is logged with who, what and when."],
          ["receipt", "One consolidated invoice", "GST-compliant tax invoice with CGST/SGST or IGST by place of supply."],
          ["lock", "Employee data protected", "Addresses are used only for delivery and never shared beyond fulfilment."]
        ].each do |ic, title, body| %>
          <div>
            <dt class="flex items-center gap-3 font-semibold"><span class="grid h-9 w-9 place-items-center rounded-lg bg-white/10 text-saffron-300 ring-1 ring-white/15"><%= icon(ic, class: "h-5 w-5") %></span><%= title %></dt>
            <dd class="mt-2 text-sm leading-relaxed text-plum-200"><%= body %></dd>
          </div>
        <% end %>
      </dl>
      <%= link_to new_contact_path, class: "btn btn-lg group mt-10 bg-white text-slate-950 hover:bg-slate-100", data: { track: "Enterprise: Request a walkthrough" } do %>Request a walkthrough <%= icon("arrow-right", class: "h-4 w-4 transition group-hover:translate-x-1", stroke: 2.2) %><% end %>
    </div>

    <div class="relative" aria-hidden="true" data-reveal-target="item">
      <div class="rounded-2xl bg-white p-6 text-slate-900 shadow-2xl ring-1 ring-white/10 sm:p-8">
        <div class="flex items-start justify-between border-b border-slate-100 pb-5">
          <div><p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Tax invoice</p><p class="mt-1 text-lg font-bold">INV-2026-01842</p></div>
          <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200">Paid</span>
        </div>
        <dl class="mt-5 space-y-3 text-sm">
          <% [["Signature Diwali hamper × 1,840", "Branded, personalised"], ["Doorstep delivery · 18 cities", "AWB tracked"], ["Personalised greeting cards", "Included"]].each do |item, note| %>
            <div class="flex justify-between gap-4"><dt class="text-slate-700"><%= item %></dt><dd class="text-slate-400"><%= note %></dd></div>
          <% end %>
        </dl>
        <div class="mt-5 space-y-2 rounded-xl bg-slate-50 p-4 text-sm">
          <div class="flex justify-between"><span class="text-slate-500">Place of supply</span><span class="font-medium">Karnataka</span></div>
          <div class="flex justify-between"><span class="text-slate-500">Tax split</span><span class="font-medium">CGST + SGST</span></div>
          <div class="flex justify-between"><span class="text-slate-500">Approved by</span><span class="font-medium">Finance · 2 approvers</span></div>
        </div>
        <div class="mt-5 flex items-center gap-3 rounded-xl border border-slate-200 p-3 text-sm">
          <span class="grid h-9 w-9 place-items-center rounded-lg bg-plum-950 text-white"><%= icon("download", class: "h-4 w-4") %></span>
          <span class="flex-1"><span class="block font-semibold">Delivery report</span><span class="block text-xs text-slate-500">Per-recipient proof of delivery · CSV</span></span>
        </div>
      </div>
      <div class="absolute -bottom-8 right-6 hidden rounded-2xl bg-white px-5 py-4 ring-1 ring-slate-200 text-slate-900 shadow-2xl animate-float-slow sm:block">
        <p class="text-xs font-medium text-slate-500">Audit log</p>
        <p class="mt-0.5 text-sm font-semibold">Order approved · 10:42 AM</p>
      </div>
    </div>
  </div>
</section>

<%# =============================== TESTIMONIAL =============================== %>
<section class="bg-white py-24" data-controller="reveal">
  <figure class="mx-auto max-w-4xl px-6 text-center" data-reveal-target="item">
    <div class="flex justify-center gap-1 text-amber-400"><% 5.times do %><%= icon("star", class: "h-5 w-5 fill-current") %><% end %></div>
    <blockquote class="mt-8 font-display text-2xl font-bold leading-snug tracking-tight text-slate-950 sm:text-4xl">
      “We gifted 1,800 employees across 22 cities for Diwali without a single spreadsheet. The team handled everything — we just approved the quote.”
    </blockquote>
    <figcaption class="mt-8 flex items-center justify-center gap-3">
      <span class="grid h-11 w-11 place-items-center rounded-full bg-plum-950 text-sm font-bold text-white">HP</span>
      <span class="text-left"><span class="block font-semibold text-slate-900">Head of People</span><span class="block text-sm text-slate-500">Bengaluru fintech</span></span>
    </figcaption>
  </figure>
</section>

<%# =============================== FAQ =============================== %>
<section id="faq" class="scroll-mt-24 border-t border-slate-100 bg-slate-50 py-24" data-controller="reveal">
  <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-3">
    <div data-reveal-target="item">
      <p class="text-sm font-semibold text-saffron-600">FAQ</p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-slate-950">Frequently asked questions</h2>
      <p class="mt-4 text-slate-600">Can't find what you're looking for?</p>
      <%= link_to new_contact_path, class: "mt-2 inline-flex items-center gap-1.5 font-semibold text-saffron-600 hover:text-saffron-700", data: { track: "FAQ: Contact our team" } do %>Contact our team <%= icon("arrow-right", class: "h-4 w-4") %><% end %>
    </div>
    <div class="divide-y divide-slate-200 rounded-2xl bg-white px-6 ring-1 ring-slate-200 lg:col-span-2">
      <% @faqs.each do |faq| %>
        <details class="group py-5" data-reveal-target="item">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
            <%= faq.question %>
            <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-slate-500 ring-1 ring-slate-200 transition group-open:rotate-45 group-open:bg-plum-950 group-open:text-white group-open:ring-plum-950"><%= icon("plus", class: "h-4 w-4", stroke: 2.2) %></span>
          </summary>
          <p class="mt-3 pr-10 text-sm leading-relaxed text-slate-600"><%= faq.answer %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>

<%# =============================== CTA =============================== %>
<section class="bg-white px-6 py-24">
  <div class="relative mx-auto max-w-6xl overflow-hidden rounded-3xl bg-plum-950 px-8 py-16 text-white sm:px-16 sm:py-20">
    <div class="absolute inset-0 pattern-grid-dark"></div>
    <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-saffron-500/25 blur-3xl"></div>
    <div class="absolute -bottom-24 left-1/3 h-80 w-80 rounded-full bg-rani-500/20 blur-3xl"></div>
    <div class="relative grid items-center gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Planning gifts for your team?</h2>
        <p class="mt-4 max-w-xl text-lg text-plum-200">Share the occasion, headcount and budget. We'll send curated options with a custom quote within one business day.</p>
      </div>
      <div class="flex flex-col gap-3">
        <%= link_to new_contact_path, class: "btn btn-lg group bg-white text-slate-950 hover:bg-slate-100", data: { track: "CTA: Get a free quote" } do %>Get a free quote <%= icon("arrow-right", class: "h-5 w-5 transition group-hover:translate-x-1", stroke: 2.2) %><% end %>
        <%= link_to "tel:#{Setting[:support_phone].to_s.delete(' ')}", class: "btn btn-lg bg-white/10 text-white ring-1 ring-white/20 hover:bg-white/15", data: { track: "CTA: Call us" } do %><%= icon("phone", class: "h-5 w-5") %> <%= Setting[:support_phone] %><% end %>
      </div>
    </div>
  </div>
</section>

<%# Sticky mobile quote bar %>
<div class="fixed inset-x-3 bottom-3 z-40 lg:hidden">
  <%= link_to new_contact_path, class: "btn btn-lg w-full bg-plum-950 text-white shadow-2xl", data: { track: "Mobile sticky: Get a quote" } do %>Get a custom quote <%= icon("arrow-right", class: "h-4 w-4", stroke: 2.2) %><% end %>
</div>
