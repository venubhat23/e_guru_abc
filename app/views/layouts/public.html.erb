<!DOCTYPE html>
<html lang="en">
  <head><%= render "shared/head" %></head>
  <body class="bg-cream-50 text-slate-800" data-controller="traffic" data-traffic-url-value="<%= site_events_path %>">
    <%= render "shared/flash" %>
    <%= render "public/navbar" %>
    <main><%= yield %></main>
    <%= render "public/footer" %>
    <% wa = Setting[:support_phone].to_s.gsub(/\D/, "") %>
    <a href="https://wa.me/<%= wa %>?text=<%= ERB::Util.url_encode("Hi! I'd like a quote for corporate gifts.") %>" target="_blank" rel="noopener" data-track="Floating: WhatsApp" aria-label="Chat with us on WhatsApp"
       class="group fixed bottom-20 right-4 z-40 flex items-center gap-2 lg:bottom-6 lg:right-6">
      <span class="hidden rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-800 shadow-xl ring-1 ring-slate-200 transition group-hover:-translate-x-1 sm:block">Chat with us!</span>
      <span class="relative grid h-14 w-14 place-items-center rounded-full bg-emerald-500 text-white shadow-2xl shadow-emerald-500/40 transition group-hover:scale-110">
        <span class="absolute inset-0 animate-ping rounded-full bg-emerald-400 opacity-30"></span>
        <svg viewBox="0 0 24 24" fill="currentColor" class="relative h-7 w-7" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3ZM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8Zm0-21.6A11.8 11.8 0 0 0 1.9 17.9L.2 24l6.3-1.7A11.8 11.8 0 1 0 12 .2Z"/></svg>
      </span>
    </a>
  </body>
</html>
