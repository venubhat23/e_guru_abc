<div class="pointer-events-none fixed inset-x-0 bottom-6 z-[60] flex flex-col-reverse items-center gap-2 px-4 sm:items-end sm:pr-6" aria-live="polite">
  <% { notice: ["bg-emerald-600", "check-circle"], alert: ["bg-rani-600", "bell"] }.each do |type, (bg, ic)| %>
    <% if flash[type].present? %>
      <div data-controller="flash" class="pointer-events-auto flex w-full max-w-sm items-start gap-3 rounded-2xl <%= bg %> px-4 py-3 text-sm font-medium text-white shadow-2xl shadow-black/20 ring-1 ring-white/20 animate-fade-up" role="status">
        <%= icon(ic, class: "mt-0.5 h-5 w-5 shrink-0") %>
        <p class="flex-1"><%= flash[type] %></p>
        <button type="button" data-action="flash#dismiss" class="rounded-md p-0.5 text-white/80 hover:bg-white/15" aria-label="Dismiss"><%= icon("x", class: "h-4 w-4") %></button>
      </div>
    <% end %>
  <% end %>
</div>
