<% page_title "Choose a new password" %>
<div class="animate-fade-up">
  <h1 class="font-display text-4xl font-semibold text-plum-950">Choose a new password</h1>
  <p class="mt-2 text-slate-500">For <%= @user.email_address %></p>
  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-8 space-y-5", data: { turbo: false } do |f| %>
    <div><%= f.label :password, "New password", class: "label" %><%= f.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input py-3" %><p class="hint">At least 8 characters.</p></div>
    <div><%= f.label :password_confirmation, "Confirm password", class: "label" %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input py-3" %></div>
    <%= f.submit "Save password", class: "btn btn-primary btn-lg w-full" %>
  <% end %>
</div>
