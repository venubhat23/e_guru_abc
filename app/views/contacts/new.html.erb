<% page_title "Book a demo" %>
<% meta_description "Talk to Avighna eGiftMitra's corporate gifting experts. Share your occasion, headcount and budget — get curated options within one business day." %>
<section class="relative overflow-hidden pt-28 pb-24 sm:pt-36">
  <div class="absolute inset-0 pattern-dots opacity-50"></div>
  <div class="absolute -top-20 right-0 h-96 w-96 rounded-full bg-gradient-to-br from-marigold-300/40 to-rani-300/40 blur-3xl"></div>
  <div class="relative mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-5">
    <div class="lg:col-span-2 animate-fade-up">
      <p class="text-sm font-semibold uppercase tracking-widest text-saffron-600">Contact us</p>
      <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-plum-950 sm:text-5xl">Let's plan something your team will remember</h1>
      <p class="mt-5 text-lg text-slate-600">Share a few details and a gifting specialist will reach out within one business day with curated options and pricing.</p>
      <ul class="mt-10 space-y-5">
        <% [["clock", "Response within 1 business day", "Usually much faster during festive season."], ["gift", "Free samples for 200+ employees", "Touch and feel before you commit."], ["lock", "Your data stays private", "We never share your details with third parties."]].each do |ic, t, b| %>
          <li class="flex gap-4"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-white text-saffron-600 shadow-sm ring-1 ring-saffron-100"><%= icon(ic) %></span><div><p class="font-semibold text-slate-900"><%= t %></p><p class="text-sm text-slate-500"><%= b %></p></div></li>
        <% end %>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <%= form_with model: @lead, url: contact_path, scope: :lead, class: "card card-body space-y-5 shadow-xl shadow-plum-900/5 sm:p-8", data: { turbo: false } do |f| %>
        <% if @lead.errors.any? %>
          <div class="rounded-xl bg-rani-50 p-4 text-sm text-rani-700 ring-1 ring-rani-200" role="alert">Please fix the highlighted fields below.</div>
        <% end %>
        <div class="hidden" aria-hidden="true">
          <label for="lead_website">Leave this empty</label>
          <input type="text" name="lead[website]" id="lead_website" tabindex="-1" autocomplete="off">
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div><%= f.label :name, "Your name", class: "label" %><%= f.text_field :name, class: field_classes(@lead, :name), required: true, autocomplete: "name" %><%= field_error(@lead, :name) %></div>
          <div><%= f.label :work_email, "Work email", class: "label" %><%= f.email_field :work_email, class: field_classes(@lead, :work_email), required: true, autocomplete: "email", placeholder: "you@company.com" %><%= field_error(@lead, :work_email) %></div>
          <div><%= f.label :phone, class: "label" %><%= f.telephone_field :phone, class: field_classes(@lead, :phone), required: true, autocomplete: "tel", placeholder: "+91 98765 43210" %><%= field_error(@lead, :phone) %></div>
          <div><%= f.label :company_name, "Company", class: "label" %><%= f.text_field :company_name, class: field_classes(@lead, :company_name), required: true, autocomplete: "organization" %><%= field_error(@lead, :company_name) %></div>
          <div><%= f.label :employee_count, "Number of employees", class: "label" %><%= f.number_field :employee_count, class: field_classes(@lead, :employee_count), min: 1, placeholder: "e.g. 250" %><%= field_error(@lead, :employee_count) %></div>
          <div><%= f.label :occasion_id, "Occasion", class: "label" %><%= f.collection_select :occasion_id, @occasions, :id, :name, { include_blank: "Select an occasion" }, class: field_classes(@lead, :occasion_id) %></div>
          <div class="sm:col-span-2">
            <%= f.label :budget_per_employee_rupees, "Budget per employee (₹)", class: "label" %>
            <div class="relative"><span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-sm text-slate-400">₹</span><%= f.number_field :budget_per_employee_rupees, class: "#{field_classes(@lead, :budget_per_employee_paise)} pl-8", min: 0, step: 50, placeholder: "1500" %></div>
            <%= field_error(@lead, :budget_per_employee_paise) %>
          </div>
          <div class="sm:col-span-2"><%= f.label :message, "Anything else we should know?", class: "label" %><%= f.text_area :message, rows: 4, class: field_classes(@lead, :message), placeholder: "Locations, timelines, branding needs…" %><%= field_error(@lead, :message) %></div>
        </div>
        <div>
          <label class="flex items-start gap-3 text-sm text-slate-600">
            <%= f.check_box :consent, class: "checkbox mt-0.5" %>
            <span>I agree to be contacted by Avighna eGiftMitra about my enquiry and accept the <%= link_to "Privacy Policy", legal_page_path("privacy-policy"), class: "font-semibold text-saffron-600 underline", target: "_blank" %>.</span>
          </label>
          <%= field_error(@lead, :consent) %>
        </div>
        <%= f.button type: "submit", class: "btn btn-primary btn-lg w-full" do %>Send my enquiry <%= icon("arrow-right", class: "h-5 w-5", stroke: 2) %><% end %>
      <% end %>
    </div>
  </div>
</section>
