<header data-controller="navbar" data-navbar-sticky-value="<%= content_for?(:dark_hero) %>" data-action="scroll@window->navbar#onScroll" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div data-navbar-target="bar" class="<%= content_for?(:dark_hero) ? "bg-white/95 backdrop-blur-xl shadow-lg ring-1 ring-slate-200/60" : "" %> mx-auto mt-3 flex max-w-7xl items-center justify-between rounded-2xl px-4 py-3 transition-all duration-300 sm:px-6 mx-3 sm:mx-6 xl:mx-auto">
    <%= link_to root_path, class: "flex items-center gap-2.5" do %>
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-saffron-500 to-rani-500 text-white shadow-lg shadow-saffron-500/30"><%= icon("gift", class: "h-5 w-5", stroke: 2) %></span>
      <span class="font-display text-xl font-semibold text-plum-900">Avighna <span class="text-saffron-600">eGiftMitra</span></span>
    <% end %>
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      <% [["Occasions", root_path(anchor: "occasions")], ["Build a box", root_path(anchor: "build")], ["How it works", how_it_works_path], ["Why us", root_path(anchor: "why-us")], ["FAQ", root_path(anchor: "faq")], ["For vendors", vendor_signup_path]].each do |label, path| %>
        <%= link_to label, path, class: "rounded-xl px-3.5 py-2 text-sm font-medium text-slate-700 transition hover:bg-white hover:text-plum-900" %>
      <% end %>
    </nav>
    <div class="hidden items-center gap-2 lg:flex">
      <% if current_user %>
        <%= link_to "Go to dashboard", portal_home_path(current_user), class: "btn btn-dark" %>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: "btn btn-ghost" %>
        <%= link_to new_contact_path, class: "btn btn-primary" do %>Book a demo <%= icon("arrow-right", class: "h-4 w-4", stroke: 2) %><% end %>
      <% end %>
    </div>
    <button type="button" class="rounded-xl p-2 text-plum-900 hover:bg-white lg:hidden" data-action="navbar#toggle" aria-label="Open menu"><%= icon("menu", class: "h-6 w-6") %></button>
  </div>
  <div data-navbar-target="mobile" class="mx-3 mt-2 hidden rounded-2xl bg-white p-4 shadow-2xl ring-1 ring-slate-200 lg:hidden">
    <% [["Occasions", root_path(anchor: "occasions")], ["Build a box", root_path(anchor: "build")], ["How it works", how_it_works_path], ["Why us", root_path(anchor: "why-us")], ["FAQ", root_path(anchor: "faq")], ["For vendors", vendor_signup_path], ["Sign in", new_session_path]].each do |label, path| %>
      <%= link_to label, path, class: "block rounded-xl px-3 py-2.5 font-medium text-slate-700 hover:bg-cream-100", data: { action: "navbar#close" } %>
    <% end %>
    <%= link_to "Book a demo", new_contact_path, class: "btn btn-primary mt-3 w-full" %>
  </div>
</header>
