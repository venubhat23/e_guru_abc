<% page_title "Dashboard" %>
<div class="relative mb-8 overflow-hidden rounded-3xl bg-gradient-to-br from-[#0c2421] via-emerald-900 to-teal-700 p-6 text-white shadow-xl sm:p-8">
  <div class="absolute inset-0 pattern-grid-dark"></div>
  <div class="absolute -right-10 -top-10 h-56 w-56 rounded-full bg-emerald-400/30 blur-3xl"></div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm text-emerald-100/80"><%= @vendor.name %></p>
      <h1 class="mt-1 font-display text-3xl font-semibold">Welcome, <%= current_user.first_name %> 🤝</h1>
      <p class="mt-2 text-sm text-emerald-50/80">Application status: <strong class="text-white"><%= @vendor.status.humanize %></strong></p>
    </div>
    <%= vendor_status_badge(@vendor) %>
  </div>
</div>
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <%= render Ui::StatCardComponent.new(label: "New assignments", value: 0, icon: "inbox", tone: :green) %>
  <%= render Ui::StatCardComponent.new(label: "In production", value: 0, icon: "cube", tone: :blue) %>
  <%= render Ui::StatCardComponent.new(label: "Payouts due", value: inr(0), icon: "banknotes", tone: :orange) %>
  <%= render Ui::StatCardComponent.new(label: "Active offers", value: 0, icon: "tag", tone: :purple) %>
</div>
<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <div class="card card-body lg:col-span-2">
    <h2 class="font-semibold text-slate-900">Onboarding checklist</h2>
    <% done = @steps.count { _1[:done] } %>
    <div class="mt-3 flex items-center gap-3"><div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-gradient-to-r from-emerald-500 to-teal-400" style="width: <%= (done * 100 / @steps.size) %>%"></div></div><span class="text-xs font-semibold text-slate-600"><%= done %>/<%= @steps.size %></span></div>
    <ul class="mt-5 space-y-2">
      <% @steps.each do |s| %>
        <li class="flex items-center gap-3 rounded-xl px-3 py-2.5 <%= s[:done] ? 'bg-emerald-50/60' : 'ring-1 ring-slate-100' %>">
          <span class="grid h-7 w-7 place-items-center rounded-full <%= s[:done] ? 'bg-emerald-500 text-white' : 'bg-slate-100 text-slate-400' %>"><%= icon(s[:done] ? "check" : "clock", class: "h-4 w-4", stroke: 2.2) %></span>
          <span class="text-sm font-medium <%= s[:done] ? 'text-slate-500 line-through' : 'text-slate-800' %>"><%= s[:label] %></span>
        </li>
      <% end %>
    </ul>
    <p class="mt-4 text-xs text-slate-500">The KYC onboarding wizard opens in Phase 2.</p>
  </div>
  <div class="card card-body">
    <h2 class="font-semibold text-slate-900">Need help?</h2>
    <p class="mt-2 text-sm text-slate-600">Our vendor success team is here Mon–Sat, 10am–7pm.</p>
    <p class="mt-4 flex items-center gap-2 text-sm"><%= icon("mail", class: "h-4 w-4 text-emerald-600") %> <%= Setting[:support_email] %></p>
    <p class="mt-2 flex items-center gap-2 text-sm"><%= icon("phone", class: "h-4 w-4 text-emerald-600") %> <%= Setting[:support_phone] %></p>
  </div>
</div>
