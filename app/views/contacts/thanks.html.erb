<% page_title "Thank you" %>
<section class="relative overflow-hidden pt-36 pb-28">
  <div class="absolute inset-0 pattern-dots opacity-50"></div>
  <div class="relative mx-auto max-w-xl px-6 text-center animate-fade-up">
    <div class="mx-auto grid h-24 w-24 place-items-center rounded-full bg-gradient-to-br from-saffron-500 to-rani-500 text-5xl shadow-2xl shadow-rani-500/30 animate-float">🎉</div>
    <h1 class="mt-8 font-display text-4xl font-semibold text-plum-950 sm:text-5xl">Thank you<%= ", #{@name}" if @name %>!</h1>
    <p class="mt-4 text-lg text-slate-600">We've received your enquiry and sent a confirmation to your inbox. A gifting specialist will call you within one business day.</p>
    <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
      <%= link_to "Explore occasions", root_path(anchor: "occasions"), class: "btn btn-primary btn-lg" %>
      <%= link_to "How it works", how_it_works_path, class: "btn btn-secondary btn-lg" %>
    </div>
  </div>
</section>
