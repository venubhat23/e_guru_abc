<% page_title "Verify your email" %>
<div class="animate-fade-up">
  <span class="grid h-14 w-14 place-items-center rounded-2xl bg-emerald-50 text-emerald-600 ring-1 ring-emerald-100"><%= icon("mail", class: "h-7 w-7") %></span>
  <h1 class="mt-6 font-display text-4xl font-semibold text-plum-950">Check your inbox</h1>
  <p class="mt-2 text-slate-500">We sent a verification link<%= " to #{@email}" if @email %>. Didn't get it? Request a new one.</p>
  <%= form_with url: email_verification_path, class: "mt-8 space-y-5", data: { turbo: false } do |f| %>
    <div><%= f.label :email_address, "Email", class: "label" %><%= f.email_field :email_address, value: @email, required: true, class: "input py-3" %></div>
    <%= f.submit "Resend verification link", class: "btn btn-primary btn-lg w-full" %>
  <% end %>
  <p class="mt-8 text-center text-sm text-slate-500"><%= link_to "← Back to sign in", new_session_path, class: "font-semibold text-saffron-600" %></p>
</div>
