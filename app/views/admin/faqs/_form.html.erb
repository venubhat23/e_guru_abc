<%= form_with model: [:admin, @record], class: "card card-body max-w-3xl space-y-5" do |f| %>
  <div><%= f.label :question, class: "label" %><%= f.text_field :question, class: field_classes(@record, :question), required: true %><%= field_error(@record, :question) %></div>
  <div><%= f.label :answer, class: "label" %><%= f.text_area :answer, rows: 5, class: field_classes(@record, :answer), required: true %><%= field_error(@record, :answer) %></div>
  <div class="grid gap-5 sm:grid-cols-2">
    <div><%= f.label :audience, class: "label" %><%= f.select :audience, Faq::AUDIENCES.map { [_1 == "public" ? "Public (companies)" : "Vendors", _1] }, {}, class: "input" %></div>
    <div><%= f.label :position, "Display order", class: "label" %><%= f.number_field :position, class: "input" %></div>
  </div>
  <label class="flex items-center gap-2 text-sm font-medium text-slate-700"><%= f.check_box :active, class: "checkbox" %> Active</label>
  <div class="flex gap-2 border-t border-slate-100 pt-5"><%= f.submit "Save FAQ", class: "btn btn-primary" %><%= link_to "Cancel", admin_faqs_path, class: "btn btn-ghost" %></div>
<% end %>
