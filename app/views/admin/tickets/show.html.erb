<% page_title @ticket.number %>
<% t = @ticket %>
<%= render "admin/shared/back", path: admin_tickets_path, label: "Tickets" %>
<%= render Ui::PageHeaderComponent.new(title: t.subject, subtitle: "#{t.number} · #{t.company.name} · booking #{t.booking.number}", eyebrow: t.category_label) do |c| %>
  <% c.with_actions do %>
    <%= render Ui::BadgeComponent.new(text: t.priority.capitalize, tone: ApplicationHelper::PRIORITY_TONES[t.priority]) %><%= status_badge(:ticket, t.status) %>
    <% if policy(t).transition? %>
      <% if t.may_start? %><%= button_to "Start working", transition_admin_ticket_path(t, event: "start"), method: :patch, class: "btn btn-secondary" %><% end %>
      <% if t.may_close? %><%= button_to "Close", transition_admin_ticket_path(t, event: "close"), method: :patch, class: "btn btn-secondary" %><% end %>
      <% if t.may_reopen? %><%= button_to "Reopen", transition_admin_ticket_path(t, event: "reopen"), method: :patch, class: "btn btn-ghost" %><% end %>
    <% end %>
  <% end %>
<% end %>
<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <div class="card card-body">
      <p class="text-sm text-slate-700"><%= simple_format(t.description.presence || "No description.") %></p>
      <p class="mt-3 text-xs text-slate-400">Raised by <%= t.raised_by&.name %> <%= time_ago(t.created_at) %><%= " · recipient #{t.booking_recipient.name} (#{t.booking_recipient.city})" if t.booking_recipient %></p>
      <% if t.resolution.present? %><div class="mt-4 rounded-xl bg-emerald-50 p-4 text-sm text-emerald-800"><strong>Resolution:</strong> <%= t.resolution %></div><% end %>
    </div>
    <div class="card card-body" id="comments">
      <h2 class="font-semibold text-slate-900">Conversation</h2>
      <ol class="mt-4 space-y-3">
        <% t.comments.includes(:user).each do |cm| %>
          <li class="rounded-xl p-3 <%= cm.internal ? 'bg-amber-50 ring-1 ring-amber-100' : 'bg-slate-50' %>">
            <p class="text-sm text-slate-800"><%= cm.body %></p>
            <p class="mt-1 text-xs text-slate-400"><%= cm.user&.name %> · <%= cm.created_at.strftime("%d %b %H:%M") %><%= " · internal note" if cm.internal %></p>
          </li>
        <% end %>
      </ol>
      <%= form_with url: admin_ticket_comments_path(t), scope: :ticket_comment, class: "mt-4 space-y-2" do |f| %>
        <%= f.text_area :body, rows: 2, required: true, placeholder: "Write a reply…", class: "input" %>
        <div class="flex items-center justify-between"><label class="flex items-center gap-2 text-xs text-slate-600"><%= f.check_box :internal, class: "checkbox" %> Internal note (not visible to HR)</label><%= f.submit "Add comment", class: "btn btn-dark btn-sm" %></div>
      <% end %>
    </div>
  </div>
  <div class="space-y-6">
    <% if policy(t).update? %>
      <%= form_with model: [:admin, t], class: "card card-body space-y-4" do |f| %>
        <h2 class="font-semibold text-slate-900">Triage</h2>
        <div><%= f.label :assignee_id, "Assignee", class: "label" %><%= f.collection_select :assignee_id, @admins, :id, :name, { include_blank: "Unassigned" }, class: "input" %></div>
        <div><%= f.label :priority, class: "label" %><%= f.select :priority, Ticket::PRIORITIES.map { [_1.capitalize, _1] }, {}, class: "input" %></div>
        <%= f.submit "Save", class: "btn btn-dark w-full" %>
      <% end %>
      <% if t.may_resolve? || t.open? || t.in_progress? %>
        <%= form_with url: transition_admin_ticket_path(t, event: "resolve"), method: :patch, class: "card card-body space-y-3" do |f| %>
          <h2 class="font-semibold text-slate-900">Resolve</h2>
          <%= f.text_area :resolution, rows: 3, required: true, placeholder: "What was done (replacement, credit note…)", class: "input" %>
          <%= f.submit "Mark resolved", class: "btn btn-success w-full" %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
