<% page_title @product.name %>
<%= render "admin/shared/back", path: admin_products_path, label: "Products" %>
<%= render Ui::PageHeaderComponent.new(title: @product.name, subtitle: "#{@product.sku} · #{@product.category.name}", eyebrow: "Product") do |c| %>
  <% c.with_actions do %>
    <%= status_badge(:review, @product.review_status, "Review: #{@product.review_status}") %>
    <% if policy(@product).update? %><%= link_to "Edit", edit_admin_product_path(@product), class: "btn btn-secondary" %><% end %>
  <% end %>
<% end %>
<% if @product.review_status == "pending" && policy(@product).review? %>
  <div class="mb-6 rounded-2xl bg-amber-50 p-5 ring-1 ring-amber-200">
    <p class="font-semibold text-amber-900">Proposed by <%= @product.proposed_by_vendor&.name %> — review before it joins the master catalogue</p>
    <%= form_with url: review_admin_product_path(@product), method: :patch, class: "mt-3 flex flex-col gap-3 sm:flex-row" do |f| %>
      <%= f.text_field :note, placeholder: "Note to vendor (optional)", class: "input flex-1" %>
      <%= f.button "Approve", name: "decision", value: "approved", class: "btn btn-success" %>
      <%= f.button "Reject", name: "decision", value: "rejected", class: "btn btn-danger" %>
    <% end %>
  </div>
<% end %>
<div class="grid gap-6 lg:grid-cols-3">
  <div class="card card-body">
    <div class="flex items-center gap-4">
      <% if @product.images.attached? %><%= image_tag @product.images.first, class: "h-20 w-20 rounded-2xl object-cover" %><% else %><%= item_emoji_tile(@product.display_emoji, size: "h-20 w-20 text-4xl") %><% end %>
      <div><p class="text-sm text-slate-600"><%= @product.description %></p></div>
    </div>
    <div class="mt-5"><%= render "admin/shared/dl", rows: [["HSN", @product.hsn_code], ["GST", "#{@product.gst_rate.to_i}%"], ["Volume units", @product.volume_units], ["Brandable", @product.brandable ? "Yes" : "No"],
      ["Markup override", @product.markup_override_pct && "#{@product.markup_override_pct.to_f}%"], ["Variants", @product.variants.map { |k, v| "#{k}: #{Array(v).join(', ')}" }.join(" · ")]] %></div>
  </div>
  <div class="card lg:col-span-2">
    <div class="border-b border-slate-100 px-6 py-4"><h2 class="font-semibold text-slate-900">Vendor offers & resulting price</h2></div>
    <% if @offers.any? %>
      <table class="table">
        <thead><tr><th>Vendor</th><th class="text-right">Vendor price</th><th class="text-right">HR price</th><th class="text-right">Margin</th><th class="text-right">Lead</th><th>Status</th></tr></thead>
        <tbody>
          <% @offers.each do |o| %>
            <% b = @calc.breakdown(o.vendor_price_paise, product: @product) %>
            <tr>
              <td><%= link_to o.vendor.name, admin_vendor_path(o.vendor), class: "font-medium hover:text-saffron-700" %></td>
              <td class="text-right tabular-nums"><%= inr(o.vendor_price_paise) %></td>
              <td class="text-right font-semibold tabular-nums"><%= inr(b.hr_paise) %></td>
              <td class="text-right tabular-nums text-emerald-700"><%= inr(b.margin_paise) %> <span class="text-xs text-slate-400">(<%= b.margin_pct %>%)</span></td>
              <td class="text-right"><%= o.lead_time_days %>d</td>
              <td><%= active_badge(o.active && o.vendor.approved?) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% b = @calc.breakdown(@offers.first.vendor_price_paise, product: @product) %>
      <p class="border-t border-slate-100 px-6 py-3 text-xs text-slate-500">Markup <strong><%= b.markup_pct.to_f %>%</strong> from <strong><%= b.markup_source %></strong> · rounded up to nearest ₹<%= Setting[:price_rounding_step_rupees] %></p>
    <% else %>
      <div class="p-6"><%= render Ui::EmptyStateComponent.new(title: "No vendor offers yet", body: "Vendors add offers from their portal.", icon: "tag") %></div>
    <% end %>
  </div>
</div>
