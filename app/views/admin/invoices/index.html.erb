<% page_title "Invoices" %>
<%= render Ui::PageHeaderComponent.new(title: "Invoices & credit notes", subtitle: "GST tax invoices to companies, auto-numbered per financial year (INV/2026-27/0001), plus credit notes for refunds.", eyebrow: "Finance") %>
<div class="mb-6 grid gap-4 sm:grid-cols-3">
  <%= render Ui::StatCardComponent.new(label: "Invoiced", value: inr(@totals["tax_invoice"].to_i), icon: "receipt", tone: :orange) %>
  <%= render Ui::StatCardComponent.new(label: "Credited", value: inr(@totals["credit_note"].to_i), icon: "switch", tone: :pink) %>
  <%= render Ui::StatCardComponent.new(label: "Net billed", value: inr(@totals["tax_invoice"].to_i - @totals["credit_note"].to_i), icon: "rupee", tone: :green) %>
</div>
<%= form_with url: admin_invoices_path, method: :get, class: "card card-body mb-5 grid gap-3 sm:grid-cols-4", data: { controller: "autosubmit" } do |f| %>
  <%= f.search_field :q, value: params[:q], placeholder: "Invoice number…", class: "input", data: { action: "input->autosubmit#debounced" }, aria: { label: "Invoice number" } %>
  <%= f.select :kind, options_for_select([["All documents", ""]] + Invoice::KINDS.invert.to_a, params[:kind]), {}, class: "input", data: { action: "autosubmit#submit" }, aria: { label: "Type" } %>
  <%= f.select :fy, options_for_select(@years.map { ["FY #{_1}", _1] }, params[:fy]), { include_blank: "All financial years" }, class: "input", data: { action: "autosubmit#submit" }, aria: { label: "Financial year" } %>
  <%= f.select :company_id, options_from_collection_for_select(@companies, :id, :name, params[:company_id]), { include_blank: "All companies" }, class: "input", data: { action: "autosubmit#submit" }, aria: { label: "Company" } %>
<% end %>
<% if @invoices.any? %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Number</th><th>Type</th><th>Company</th><th>Booking</th><th>Issued</th><th class="text-right">Taxable</th><th class="text-right">GST</th><th class="text-right">Total</th><th></th></tr></thead>
      <tbody>
        <% @invoices.each do |inv| %>
          <tr>
            <td class="font-mono text-xs font-semibold text-plum-900"><%= inv.number %></td>
            <td><%= render Ui::BadgeComponent.new(text: inv.kind_label, tone: inv.kind == "credit_note" ? :pink : :orange, dot: false) %></td>
            <td><%= inv.company.name %></td>
            <td class="font-mono text-xs"><%= link_to inv.booking.number, admin_booking_path(inv.booking), class: "hover:text-saffron-700" %></td>
            <td class="text-xs"><%= inv.issued_on.strftime("%d %b %Y") %></td>
            <td class="text-right tabular-nums"><%= inr(inv.taxable_paise) %></td>
            <td class="text-right tabular-nums text-slate-500"><%= inr(inv.gst_paise) %> <span class="text-[10px]"><%= inv.igst_paise.positive? ? "IGST" : "C+S" %></span></td>
            <td class="text-right font-semibold tabular-nums"><%= inr(inv.total_paise) %></td>
            <td class="text-right"><%= link_to admin_invoice_path(inv), target: "_blank", class: "btn btn-secondary btn-sm" do %><%= icon("download", class: "h-4 w-4") %> PDF<% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagy_nav_tw(@pagy) %>
<% else %>
  <%= render Ui::EmptyStateComponent.new(title: "No invoices yet", body: "Tax invoices are issued automatically when a booking completes.", icon: "receipt") %>
<% end %>
<div class="card card-body mt-6">
  <h2 class="font-semibold text-slate-900">Vendor invoices received</h2>
  <% if @vendor_invoices.any? %>
    <ul class="mt-3 space-y-2 text-sm"><% @vendor_invoices.each do |att| %><li><%= link_to att.filename.to_s, rails_blob_path(att, disposition: "inline"), target: "_blank", class: "text-saffron-600" %> · <%= time_ago(att.created_at) %></li><% end %></ul>
  <% else %><p class="mt-2 text-sm text-slate-500">Vendors upload their own tax invoices against payouts from the vendor portal.</p><% end %>
</div>
