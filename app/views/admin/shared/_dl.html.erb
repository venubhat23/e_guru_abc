<%# locals: (rows:, cols: 2) %>
<dl class="grid gap-x-6 gap-y-4 <%= cols == 2 ? 'sm:grid-cols-2' : (cols == 3 ? 'sm:grid-cols-3' : '') %>">
  <% rows.each do |label, value| %>
    <div><dt class="text-xs font-medium uppercase tracking-wide text-slate-400"><%= label %></dt><dd class="mt-1 text-sm font-medium text-slate-800"><%= value.presence || "—" %></dd></div>
  <% end %>
</dl>
