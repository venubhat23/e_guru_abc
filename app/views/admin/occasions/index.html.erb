<% page_title "Occasions" %>
<%= render Ui::PageHeaderComponent.new(title: "Occasions", subtitle: "Shown as cards on the homepage and as public preview pages.", eyebrow: "Website") do |c| %>
  <% c.with_actions { link_to(new_admin_occasion_path, class: "btn btn-primary") { icon("plus", class: "h-4 w-4", stroke: 2) + " New occasion" } } %>
<% end %>
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  <% @records.each do |o| %>
    <div class="card card-body flex items-start gap-4">
      <span class="text-4xl"><%= o.emoji %></span>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2"><p class="font-semibold text-slate-900"><%= o.name %></p><%= active_badge(o.active) %></div>
        <p class="truncate text-sm text-slate-500"><%= o.tagline %></p>
        <p class="mt-2 text-sm">from <strong><%= inr(o.from_price_paise) %></strong> · <span class="text-slate-500">/gifts/<%= o.slug %></span></p>
        <div class="mt-3 flex gap-2">
          <%= link_to "Edit", edit_admin_occasion_path(o), class: "btn btn-secondary btn-sm" %>
          <%= link_to "Preview", occasion_path(o), class: "btn btn-ghost btn-sm", target: "_blank" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
<%= pagy_nav_tw(@pagy) %>
