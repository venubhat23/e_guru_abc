<% page_title "Edit #{@vendor.name}" %>
<%= render "admin/shared/back", path: admin_vendor_path(@vendor), label: @vendor.name %>
<%= render Ui::PageHeaderComponent.new(title: "Edit vendor", eyebrow: "Supply") %>
<%= form_with model: [:admin, @vendor], class: "card card-body max-w-3xl space-y-5" do |f| %>
  <div class="grid gap-5 sm:grid-cols-2">
    <% [[:business_name, "Business name"], [:legal_name, "Legal name"], [:contact_name, "Contact person"], [:email, "Email"], [:phone, "Phone"], [:gstin, "GSTIN"], [:pan, "PAN"], [:fssai_number, "FSSAI licence no."],
        [:bank_account_name, "Bank account name"], [:bank_ifsc, "IFSC"], [:warehouse_city, "Warehouse city"], [:warehouse_pincode, "Warehouse pincode"]].each do |attr, label| %>
      <div><%= f.label attr, label, class: "label" %><%= f.text_field attr, class: field_classes(@vendor, attr) %><%= field_error(@vendor, attr) %></div>
    <% end %>
    <div><%= f.label :bank_account_number, "Bank account number", class: "label" %><%= f.text_field :bank_account_number, class: "input", autocomplete: "off" %><p class="hint">Stored encrypted (Active Record Encryption).</p></div>
    <div><%= f.label :warehouse_state, class: "label" %><%= f.select :warehouse_state, Gstin.state_names, { include_blank: true }, class: "input" %></div>
    <div class="sm:col-span-2"><%= f.label :warehouse_address, class: "label" %><%= f.text_area :warehouse_address, rows: 2, class: "input" %></div>
    <div><%= f.label :rating, "Rating (0–5)", class: "label" %><%= f.number_field :rating, step: 0.1, min: 0, max: 5, class: field_classes(@vendor, :rating) %></div>
  </div>
  <div class="flex gap-2 border-t border-slate-100 pt-5"><%= f.submit "Save vendor", class: "btn btn-primary" %><%= link_to "Cancel", admin_vendor_path(@vendor), class: "btn btn-ghost" %></div>
<% end %>
