#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Platforms like Railway route traffic to $PORT. Thruster (HTTP proxy) must listen there
# and forward to Puma on an internal port.
if [ -n "${PORT}" ] && [ "${1}" == "./bin/thrust" ]; then
  export HTTP_PORT="${PORT}"
  export TARGET_PORT="${PUMA_PORT:-3001}"
  export PORT="${TARGET_PORT}"
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  # Wait for the database (Railway public TCP proxy) to accept connections before migrating.
  DB_HOST_CHECK="acela.proxy.rlwy.net"
  DB_PORT_CHECK="31332"
  echo "[entrypoint] Waiting for database ${DB_HOST_CHECK}:${DB_PORT_CHECK}..."
  for i in $(seq 1 30); do
    if ! getent hosts "${DB_HOST_CHECK}" > /dev/null; then
      echo "[entrypoint] attempt ${i}/30: DNS cannot resolve ${DB_HOST_CHECK} "
    elif pg_isready -h "${DB_HOST_CHECK}" -p "${DB_PORT_CHECK}" -t 3; then
      echo "[entrypoint] Database reachable."
      break
    else
      echo "[entrypoint] attempt ${i}/30: ${DB_HOST_CHECK} resolves to $(getent hosts "${DB_HOST_CHECK}" | awk '{print $1}') but Postgres is not accepting connections"
    fi
    if [ "${i}" -eq 30 ]; then
      echo "[entrypoint] ERROR: database not reachable after 30 attempts." >&2
      exit 1
    fi
    sleep 2
  done

  echo "[entrypoint] Connecting to database and running db:prepare..."
  ./bin/rails db:prepare
  echo "[entrypoint] Database ready."
  # Idempotent sample data (admin, companies, vendors, leads, legal pages). Set SEED_ON_DEPLOY=true.
  if [ "${SEED_ON_DEPLOY}" == "true" ]; then
    ./bin/rails db:seed
  fi
fi

echo "[entrypoint] Starting: ${*}"
exec "${@}"
