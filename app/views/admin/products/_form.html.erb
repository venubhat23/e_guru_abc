<%= form_with model: [:admin, @product], class: "card card-body max-w-3xl space-y-5" do |f| %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2"><%= f.label :name, class: "label" %><%= f.text_field :name, class: field_classes(@product, :name), required: true %><%= field_error(@product, :name) %></div>
    <div><%= f.label :sku, "SKU", class: "label" %><%= f.text_field :sku, class: field_classes(@product, :sku), required: true %><%= field_error(@product, :sku) %></div>
    <div><%= f.label :category_id, class: "label" %><%= f.collection_select :category_id, Category.ordered, :id, :name, {}, class: "input" %></div>
    <div><%= f.label :hsn_code, "HSN code", class: "label" %><%= f.text_field :hsn_code, class: field_classes(@product, :hsn_code), required: true %><%= field_error(@product, :hsn_code) %></div>
    <div><%= f.label :gst_rate, "GST rate", class: "label" %><%= f.select :gst_rate, Product::GST_RATES.map { ["#{_1}%", _1] }, { selected: @product.gst_rate.to_i }, class: "input" %></div>
    <div><%= f.label :volume_units, class: "label" %><%= f.number_field :volume_units, min: 1, class: field_classes(@product, :volume_units) %><p class="hint">Used for Unbox box capacity.</p></div>
    <div><%= f.label :markup_override_pct, "Markup override (%)", class: "label" %><%= f.number_field :markup_override_pct, step: 0.5, class: "input", placeholder: "Use category/default" %></div>
    <div><%= f.label :emoji, "Emoji (fallback image)", class: "label" %><%= f.text_field :emoji, class: "input", maxlength: 4 %></div>
    <div><%= f.label :images, class: "label" %><%= f.file_field :images, multiple: true, accept: "image/*", class: "input" %></div>
    <div class="sm:col-span-2"><%= f.label :description, class: "label" %><%= f.text_area :description, rows: 3, class: "input" %></div>
    <div class="sm:col-span-2"><%= f.label :variants_text, "Variants (one per line, e.g. sizes: S, M, L)", class: "label" %><%= f.text_area :variants_text, value: @product.variants.map { |k, v| "#{k}: #{Array(v).join(', ')}" }.join("\n"), rows: 2, class: "input font-mono text-xs" %></div>
  </div>
  <div class="flex gap-6"><label class="flex items-center gap-2 text-sm font-medium text-slate-700"><%= f.check_box :brandable, class: "checkbox" %> Brandable (logo)</label><label class="flex items-center gap-2 text-sm font-medium text-slate-700"><%= f.check_box :active, class: "checkbox" %> Active</label></div>
  <div class="flex gap-2 border-t border-slate-100 pt-5"><%= f.submit "Save product", class: "btn btn-primary" %><%= link_to "Cancel", @product.persisted? ? admin_product_path(@product) : admin_products_path, class: "btn btn-ghost" %></div>
<% end %>
