<% page_title "Catalogue" %>
<%= render Ui::PageHeaderComponent.new(title: "Catalogue", subtitle: "Master catalogue every vendor offers against. HR prices come from the lowest active offer plus markup.", eyebrow: "Supply") do |c| %>
  <% c.with_actions do %>
    <%= link_to admin_price_preview_path, class: "btn btn-secondary" do %><%= icon("rupee", class: "h-4 w-4") %> Price preview<% end %>
    <%= link_to admin_products_path, class: "btn btn-secondary" do %><%= icon("cube", class: "h-4 w-4") %> Products<% end %>
    <%= link_to new_admin_package_path, class: "btn btn-primary" do %><%= icon("plus", class: "h-4 w-4", stroke: 2) %> New package<% end %>
  <% end %>
<% end %>

<% if @pending.any? %>
  <div class="mb-6 rounded-2xl bg-amber-50 p-5 ring-1 ring-amber-200">
    <p class="font-semibold text-amber-900"><%= pluralize(@pending.size, "vendor-proposed product") %> awaiting review</p>
    <ul class="mt-3 space-y-2">
      <% @pending.each do |p| %>
        <li class="flex items-center justify-between gap-3 rounded-xl bg-white px-4 py-3 ring-1 ring-amber-100">
          <span class="flex items-center gap-3"><%= item_emoji_tile(p.display_emoji, size: "h-9 w-9 text-lg") %><span><span class="block text-sm font-semibold"><%= p.name %></span><span class="text-xs text-slate-500">by <%= p.proposed_by_vendor&.name %> · <%= p.category.name %></span></span></span>
          <%= link_to "Review", admin_product_path(p), class: "btn btn-secondary btn-sm" %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="flex items-center justify-between"><h2 class="text-lg font-semibold text-slate-900">Packages</h2><%= link_to "All packages →", admin_packages_path, class: "text-sm font-semibold text-saffron-600" %></div>
<div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  <% @packages.each do |pkg| %>
    <% offer = @calc.lowest_offer(pkg) %>
    <%= link_to admin_package_path(pkg), class: "card card-body group transition hover:-translate-y-0.5 hover:shadow-lg" do %>
      <div class="flex items-start gap-3">
        <%= item_emoji_tile(pkg.display_emoji, size: "h-12 w-12 text-2xl") %>
        <div class="min-w-0 flex-1"><p class="font-semibold text-slate-900 group-hover:text-saffron-700"><%= pkg.name %></p><p class="text-xs text-slate-500"><%= pkg.occasion.name %> · min <%= pkg.min_qty %> · GST <%= pkg.gst_rate.to_i %>%</p></div>
        <%= active_badge(pkg.active) %>
      </div>
      <p class="mt-3 line-clamp-1 text-xs text-slate-500"><%= pkg.package_items.map { "#{_1.quantity}× #{_1.product.name}" }.join(" · ") %></p>
      <div class="mt-4 flex items-end justify-between rounded-xl bg-slate-50 px-4 py-3">
        <div><p class="text-[11px] uppercase tracking-wide text-slate-400">HR price / kit</p><p class="text-lg font-bold text-plum-900"><%= offer ? inr(@calc.hr_price(offer.vendor_price_paise)) : "No offers" %></p></div>
        <div class="text-right"><p class="text-[11px] uppercase tracking-wide text-slate-400">Lowest vendor</p><p class="text-sm font-semibold text-slate-700"><%= offer ? inr(offer.vendor_price_paise) : "—" %></p></div>
      </div>
    <% end %>
  <% end %>
</div>

<div class="mt-10 flex items-center justify-between"><h2 class="text-lg font-semibold text-slate-900">Categories</h2><%= link_to "Manage categories →", admin_categories_path, class: "text-sm font-semibold text-saffron-600" %></div>
<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
  <% @categories.each do |c| %>
    <%= link_to admin_products_path(category_id: c.id), class: "card flex flex-col items-center gap-2 p-4 text-center transition hover:-translate-y-0.5 hover:shadow-md" do %>
      <span class="text-3xl"><%= c.emoji %></span>
      <span class="text-sm font-semibold text-slate-800"><%= c.name %></span>
      <span class="text-xs text-slate-500"><%= pluralize(@product_counts[c.id].to_i, "product") %><%= " · #{c.markup_override_pct.to_i}% markup" if c.markup_override_pct %></span>
      <% if c.food? %><span class="rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-semibold text-amber-700">FSSAI</span><% end %>
    <% end %>
  <% end %>
</div>
