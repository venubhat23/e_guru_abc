<% page_title "FAQs" %>
<%= render Ui::PageHeaderComponent.new(title: "FAQs", subtitle: "Public FAQs appear on the homepage; vendor FAQs on the Become-a-vendor page.", eyebrow: "Website") do |c| %>
  <% c.with_actions { link_to(new_admin_faq_path, class: "btn btn-primary") { icon("plus", class: "h-4 w-4", stroke: 2) + " New FAQ" } } %>
<% end %>
<% if @records.any? %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th class="w-12">#</th><th>Question</th><th>Audience</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% @records.each do |faq| %>
          <tr>
            <td class="text-slate-400"><%= faq.position %></td>
            <td><p class="font-medium text-slate-900"><%= faq.question %></p><p class="line-clamp-1 text-xs text-slate-500"><%= faq.answer %></p></td>
            <td><%= render Ui::BadgeComponent.new(text: faq.audience.humanize, tone: faq.audience == "vendor" ? :green : :orange, dot: false) %></td>
            <td><%= active_badge(faq.active) %></td>
            <td class="whitespace-nowrap text-right">
              <%= link_to "Edit", edit_admin_faq_path(faq), class: "btn btn-secondary btn-sm" %>
              <%= button_to "Delete", admin_faq_path(faq), method: :delete, class: "btn btn-ghost btn-sm text-rani-600", form_class: "inline", form: { data: { turbo_confirm: "Delete this FAQ?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagy_nav_tw(@pagy) %>
<% else %>
  <%= render Ui::EmptyStateComponent.new(title: "No FAQs yet", icon: "question") %>
<% end %>
