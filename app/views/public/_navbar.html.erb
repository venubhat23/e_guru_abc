<header data-controller="navbar" data-navbar-sticky-value="true" data-action="scroll@window->navbar#onScroll" class="fixed inset-x-0 top-0 z-50">
  <%# Announcement ticker (scrolls right to left) %>
  <div class="overflow-hidden bg-plum-950 text-xs font-semibold text-white sm:text-[13px]">
    <div class="flex w-max animate-marquee gap-12 py-2.5 hover:[animation-play-state:paused]" style="animation-duration:45s">
      <% items = [["gift", "Explore our corporate gift collections"], ["star", "Premium quality, curated by experts"], ["palette", "Custom branding & printing"], ["truck", "Pan-India doorstep delivery"], ["receipt", "Single GST-compliant invoice"], ["mail", Setting[:support_email]], ["phone", Setting[:support_phone]]] %>
      <% (items * 2).each do |ic, text| %>
        <span class="flex items-center gap-2 whitespace-nowrap"><%= icon(ic, class: "h-4 w-4 text-saffron-400") %><%= text %></span>
      <% end %>
    </div>
  </div>

  <div data-navbar-target="bar" class="border-b border-slate-200/80 bg-white/95 backdrop-blur-xl transition-shadow duration-300">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <%= link_to root_path, class: "flex shrink-0 items-center gap-2.5" do %>
        <span class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-saffron-500 to-rani-500 text-white shadow-md"><%= icon("gift", class: "h-5 w-5", stroke: 2) %></span>
        <span class="leading-tight"><span class="block font-display text-lg font-bold text-plum-950">Avighna <span class="text-saffron-600">eGiftMitra</span></span><span class="block text-[10px] font-semibold uppercase tracking-[.2em] text-slate-400">Corporate gifting</span></span>
      <% end %>

      <nav class="hidden items-center gap-0.5 xl:flex" aria-label="Primary">
        <div class="group relative">
          <%= link_to products_path, class: "flex items-center gap-1 whitespace-nowrap rounded-lg px-2.5 py-2 text-sm font-semibold text-plum-900 hover:text-saffron-600" do %>Products <%= icon("chevron-down", class: "h-4 w-4 transition group-hover:rotate-180") %><% end %>
          <div class="invisible absolute left-0 top-full w-[34rem] translate-y-2 pt-2 opacity-0 transition duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
            <div class="grid grid-cols-2 gap-1 rounded-2xl bg-white p-3 shadow-2xl ring-1 ring-slate-200">
              <% Category.ordered.each do |c| %>
                <%= link_to products_path(category: c.slug), class: "flex items-center gap-3 rounded-xl p-2 hover:bg-cream-100" do %>
                  <img src="<%= stock_image_url(c.slug, w: 96, h: 96) %>" alt="" loading="lazy" class="h-10 w-10 rounded-lg object-cover">
                  <span class="text-sm font-semibold text-slate-800"><%= c.name %></span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
        <div class="group relative">
          <%= link_to root_path(anchor: "occasions"), class: "flex items-center gap-1 whitespace-nowrap rounded-lg px-2.5 py-2 text-sm font-semibold text-plum-900 hover:text-saffron-600" do %>Occasions <%= icon("chevron-down", class: "h-4 w-4 transition group-hover:rotate-180") %><% end %>
          <div class="invisible absolute left-0 top-full w-64 translate-y-2 pt-2 opacity-0 transition duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
            <div class="rounded-2xl bg-white p-2 shadow-2xl ring-1 ring-slate-200">
              <% Occasion.active.ordered.each do |o| %>
                <%= link_to occasion_path(o), class: "flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-semibold text-slate-800 hover:bg-cream-100" do %><span class="text-lg"><%= o.emoji %></span><%= o.name %><% end %>
              <% end %>
            </div>
          </div>
        </div>
        <%= link_to occasion_path("diwali"), class: "flex items-center gap-1.5 whitespace-nowrap rounded-lg px-2.5 py-2 text-sm font-semibold text-saffron-600 hover:text-saffron-700" do %>Diwali Gifting <span class="rounded bg-gradient-to-r from-saffron-500 to-rani-500 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white">Festive</span><% end %>
        <% [["How it works", how_it_works_path], ["Contact", new_contact_path]].each do |label, path| %>
          <%= link_to label, path, class: "whitespace-nowrap rounded-lg px-2.5 py-2 text-sm font-semibold text-plum-900 hover:text-saffron-600" %>
        <% end %>
      </nav>

      <div class="hidden items-center gap-2 lg:flex">
        <% if current_user %>
          <%= link_to "Go to dashboard", portal_home_path(current_user), class: "btn btn-dark" %>
        <% else %>
          <%= link_to new_session_path, class: "grid h-10 w-10 place-items-center rounded-full text-plum-900 hover:bg-slate-100", aria: { label: "Sign in" } do %><%= icon("user", class: "h-5 w-5") %><% end %>
          <%= link_to "Request quote", new_contact_path, class: "btn rounded-full bg-plum-950 px-5 text-white hover:bg-plum-800", data: { track: "Navbar: Request quote" } %>
          <%= link_to catalogue_path, class: "btn rounded-full bg-gradient-to-r from-saffron-500 to-rani-500 px-5 text-white shadow-md shadow-saffron-500/30 hover:-translate-y-0.5", target: "_blank", data: { track: "Navbar: Download catalogue" } do %><%= icon("download", class: "h-4 w-4") %> Catalogue<% end %>
        <% end %>
      </div>
      <button type="button" class="rounded-xl p-2 text-plum-900 hover:bg-slate-100 lg:hidden" data-action="navbar#toggle" aria-label="Open menu"><%= icon("menu", class: "h-6 w-6") %></button>
    </div>
  </div>

  <div data-navbar-target="mobile" class="mx-3 mt-2 hidden max-h-[75vh] overflow-y-auto rounded-2xl bg-white p-4 shadow-2xl ring-1 ring-slate-200 lg:hidden">
    <% [["Products", products_path], ["Occasions", root_path(anchor: "occasions")], ["Diwali Gifting", occasion_path("diwali")], ["How it works", how_it_works_path], ["For vendors", vendor_signup_path], ["Contact", new_contact_path], ["Sign in", new_session_path]].each do |label, path| %>
      <%= link_to label, path, class: "block rounded-xl px-3 py-2.5 font-semibold text-slate-700 hover:bg-cream-100", data: { action: "navbar#close" } %>
    <% end %>
    <div class="mt-3 grid grid-cols-2 gap-2">
      <%= link_to "Request quote", new_contact_path, class: "btn bg-plum-950 text-white" %>
      <%= link_to "Catalogue", catalogue_path, class: "btn btn-secondary", target: "_blank" %>
    </div>
  </div>
</header>
