<%= form_with model: [:admin, @package], class: "card card-body max-w-3xl space-y-5", data: { controller: "nested-form" } do |f| %>
  <% if @package.errors[:base].any? %><div class="rounded-xl bg-rani-50 p-3 text-sm text-rani-700"><%= @package.errors[:base].to_sentence %></div><% end %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2"><%= f.label :name, class: "label" %><%= f.text_field :name, class: field_classes(@package, :name), required: true %><%= field_error(@package, :name) %></div>
    <div><%= f.label :occasion_id, class: "label" %><%= f.collection_select :occasion_id, @occasions, :id, :name, {}, class: "input" %></div>
    <div><%= f.label :slug, "URL slug", class: "label" %><%= f.text_field :slug, class: field_classes(@package, :slug), placeholder: "auto from name" %></div>
    <div><%= f.label :min_qty, "Minimum quantity", class: "label" %><%= f.number_field :min_qty, min: 1, class: field_classes(@package, :min_qty) %></div>
    <div><%= f.label :emoji, class: "label" %><%= f.text_field :emoji, class: "input", maxlength: 4 %></div>
    <div class="sm:col-span-2"><%= f.label :description, class: "label" %><%= f.text_area :description, rows: 3, class: "input" %></div>
    <div class="sm:col-span-2"><%= f.label :images, class: "label" %><%= f.file_field :images, multiple: true, accept: "image/*", class: "input" %></div>
  </div>
  <div>
    <div class="mb-3 flex items-center justify-between"><p class="text-sm font-semibold text-slate-900">Items in each kit</p><button type="button" class="btn btn-secondary btn-sm" data-action="nested-form#add"><%= icon("plus", class: "h-4 w-4") %> Add item</button></div>
    <div class="space-y-3" data-nested-form-target="list">
      <%= f.fields_for :package_items do |pf| %><%= render "item_row", f: pf %><% end %>
    </div>
    <template data-nested-form-target="template">
      <%= f.fields_for :package_items, PackageItem.new(quantity: 1), child_index: "NEW_RECORD" do |pf| %><%= render "item_row", f: pf %><% end %>
    </template>
  </div>
  <label class="flex items-center gap-2 text-sm font-medium text-slate-700"><%= f.check_box :active, class: "checkbox" %> Active (visible to HR)</label>
  <div class="flex gap-2 border-t border-slate-100 pt-5"><%= f.submit "Save package", class: "btn btn-primary" %><%= link_to "Cancel", @package.persisted? ? admin_package_path(@package) : admin_packages_path, class: "btn btn-ghost" %></div>
<% end %>
