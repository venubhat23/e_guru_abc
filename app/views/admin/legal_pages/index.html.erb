<% page_title "Legal pages" %>
<%= render Ui::PageHeaderComponent.new(title: "Legal pages", subtitle: "Terms, privacy, refund policy and more. Written in Markdown, shown in the website footer.", eyebrow: "Website") do |c| %>
  <% c.with_actions { link_to(new_admin_legal_page_path, class: "btn btn-primary") { icon("plus", class: "h-4 w-4", stroke: 2) + " New page" } } %>
<% end %>
<div class="grid gap-4 md:grid-cols-2">
  <% @records.each do |p| %>
    <div class="card card-body">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3"><span class="grid h-10 w-10 place-items-center rounded-xl bg-plum-50 text-plum-700"><%= icon("scale") %></span><div><p class="font-semibold text-slate-900"><%= p.title %></p><p class="text-xs text-slate-500">/legal/<%= p.slug %> · updated <%= time_ago(p.updated_at) %></p></div></div>
        <%= render Ui::BadgeComponent.new(text: p.published ? "Published" : "Draft", tone: p.published ? :green : :gray) %>
      </div>
      <p class="mt-3 line-clamp-2 text-sm text-slate-600"><%= p.summary %></p>
      <div class="mt-4 flex gap-2">
        <%= link_to "Edit", edit_admin_legal_page_path(p), class: "btn btn-secondary btn-sm" %>
        <%= link_to "View", legal_page_path(p), class: "btn btn-ghost btn-sm", target: "_blank" %>
      </div>
    </div>
  <% end %>
</div>
